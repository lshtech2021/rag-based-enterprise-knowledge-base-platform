# Copy to .env for local overrides (never commit .env)

AUTH_MODE=dev_bypass
JWT_SECRET=dev-only-change-me

# EDGAR ingest (required for live downloads)
SEC_USER_AGENT=Annex Knowledge Base you@example.com
INGEST_DATA_DIR=data/ingestion

# OpenAI embeddings (required for live ingest / query vectors)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Compose data plane (see infra/README.md)
DATABASE_URL=postgresql://kb:kb@localhost:5432/knowledge_base
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
