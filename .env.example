# Copy to .env for local overrides (never commit .env)

AUTH_MODE=dev_bypass
JWT_SECRET=dev-only-change-me
LOG_LEVEL=INFO

# EDGAR ingest (required for live downloads)
SEC_USER_AGENT=Annex Knowledge Base you@example.com
INGEST_DATA_DIR=data/ingestion

# OpenAI / OpenAI-compatible API (required for live ingest / query / report)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Data plane: local (SQLite+FS) or compose (Postgres+pgvector+MinIO[+OpenSearch])
KB_DATA_PLANE=local

# Compose data plane (see infra/README.md). Ingest/query/report all switch to
# Postgres/pgvector + MinIO when KB_DATA_PLANE=compose; the full schema
# (companies/filings/chunks/embeddings/financial_facts/reports/
# report_citations/query_logs) is applied automatically on connect, so this
# also works against a Postgres you didn't provision via `docker compose`.
DATABASE_URL=postgresql://kb:kb@localhost:5432/knowledge_base
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kb-filings
# OpenSearch is optional even under compose: unset/unreachable just drops the
# BM25 half of hybrid retrieval and keeps dense-only search.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
